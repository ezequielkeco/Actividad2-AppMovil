<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Marila_Garden_App.Views.Request.RequestPage"
             BackgroundColor="{StaticResource Background}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
                   Padding="24"
                   Spacing="24">

            <Grid ColumnDefinitions="Auto,*,Auto"
                  Margin="0,20,0,0"
                  ColumnSpacing="14">

                <ImageButton
                  Source="menu.png"
                  Clicked="OnMenuClicked" />

                <VerticalStackLayout
                  Spacing="4"
                  Grid.Column="1">
                    <Label Text="¡Hola!"
                           Style="{StaticResource SubtitleLabel}" />

                    <Label x:Name="UserNameLabel"
                           Text="Usuario"
                           Style="{StaticResource SectionTitleLabel}" />
                </VerticalStackLayout>
                <Image Source="marila_garden_logo.png"
                       WidthRequest="130"
                       HorizontalOptions="End"
                       Aspect="AspectFit" 
                       Grid.Column="2"/>
            </Grid>

            <Label
                Text="Solicitar servicio"
                HorizontalTextAlignment="Center"
                Style="{StaticResource TitleLabel}"
                Margin="0,20,0,0" />

            <Label
                Text="Completa la información para coordinar una evaluación personalizada de tu jardín."
                HorizontalTextAlignment="Center"
                Padding="15,0"
                Style="{StaticResource SubtitleLabel}" />

            <Border
                Style="{StaticResource FormBorder}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="16">

                    <Label Text="Nombre completo"
                           Style="{StaticResource FieldLabel}" />

                    <Border BackgroundColor="{StaticResource Background}"
                            Stroke="#E5E7EB"
                            Padding="14,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Entry x:Name="FullNameEntry"
                               Placeholder="Ej. María Pérez"
                               Style="{StaticResource InputEntry}" />
                    </Border>

                    <Label Text="Teléfono"
                           Style="{StaticResource FieldLabel}" />

                    <Border BackgroundColor="{StaticResource Background}"
                            Stroke="#E5E7EB"
                            Padding="14,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Entry x:Name="PhoneEntry"
                               Placeholder="Ej. 809-000-0000"
                               Keyboard="Telephone"
                               Style="{StaticResource InputEntry}" />
                    </Border>

                    <Label Text="Tipo de servicio"
                           Style="{StaticResource FieldLabel}" />

                    <Border BackgroundColor="{StaticResource Background}"
                            Stroke="#E5E7EB"
                            Padding="14,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Picker x:Name="ServiceTypePicker"
                                Title="Selecciona un servicio"
                                Style="{StaticResource InputPicker}">
                            <Picker.Items>
                                <x:String>Diseño de jardín</x:String>
                                <x:String>Mantenimiento</x:String>
                                <x:String>Poda profesional</x:String>
                                <x:String>Plantación</x:String>
                            </Picker.Items>
                        </Picker>
                    </Border>

                    <Label Text="Fecha deseada"
                           Style="{StaticResource FieldLabel}" />

                    <Border
                        BackgroundColor="{StaticResource Background}"
                        Stroke="#E5E7EB"
                        Padding="14,4">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="10">

                            <Label
                                Text="📅"
                                FontSize="18"
                                VerticalOptions="Center" />

                            <Label
                                x:Name="SelectedDateFieldLabel"
                                Grid.Column="1"
                                Text="Selecciona una fecha"
                                TextColor="{StaticResource Black}"
                                FontSize="14"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="2"
                                Text="⌄"
                                TextColor="{StaticResource PrimaryDark}"
                                FontSize="20"
                                VerticalOptions="Center" />

                            <DatePicker
                                x:Name="DesiredDatePicker"
                                Grid.ColumnSpan="3"
                                Opacity="0.01"
                                DateSelected="DesiredDatePicker_DateSelected"
                                PropertyChanged="DesiredDatePicker_PropertyChanged" />

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDateFieldTapped" />
                            </Grid.GestureRecognizers>

                        </Grid>
                    </Border>

                    <Label
                        x:Name="SelectedDateLabel"
                        Text="Fecha seleccionada: Hoy"
                        Style="{StaticResource SubtitleLabel}"
                        Margin="4,0,0,10"
                        TextColor="{StaticResource PrimaryDark}" />

                    <Label Text="Comentarios"
                           Style="{StaticResource FieldLabel}" />

                    <Border BackgroundColor="{StaticResource Background}"
                            Stroke="#E5E7EB"
                            Padding="14,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Editor x:Name="CommentsEditor"
                                Placeholder="Describe brevemente el servicio que necesita..."
                                AutoSize="TextChanges"
                                HeightRequest="110"
                                Style="{StaticResource InputEditor}" />
                    </Border>

                    <Button
                        Text="Enviar solicitud"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,10,0,0"
                        Clicked="OnSaveRequestClicked" />

                </VerticalStackLayout>
                <Border.Shadow>
                    <Shadow
                        Brush="Black"
                        Offset="0,2"
                        Radius="10"
                        Opacity="0.1" />
                </Border.Shadow>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>