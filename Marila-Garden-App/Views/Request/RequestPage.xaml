<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Marila_Garden_App.Views.Request.RequestPage"
             BackgroundColor="{StaticResource Background}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
                   Padding="24"
                   Spacing="24">

            <Grid ColumnDefinitions="Auto,*,Auto"
                  Margin="0,20,0,0"
                  ColumnSpacing="14">

                <ImageButton
                  Source="menu.png"
                  Clicked="OnMenuClicked" />

                <VerticalStackLayout
                  Spacing="4"
                  Grid.Column="1">
                    <Label Text="¡Hola!"
                           Style="{StaticResource SubtitleLabel}" />

                    <Label x:Name="UserNameLabel"
                           Text="Usuario"
                           Style="{StaticResource SectionTitleLabel}" />
                    
                </VerticalStackLayout>
                <Image Source="marila_garden_logo.png"
                       WidthRequest="130"
                       HorizontalOptions="End"
                       Aspect="AspectFit" 
                       Grid.Column="2"/>
            </Grid>

            <Label
                Text="{Binding PageTitle}"
                HorizontalTextAlignment="Center"
                Style="{StaticResource TitleLabel}"
                Margin="0,20,0,0" />

            <Border
                BackgroundColor="#EAF7E3"
                StrokeThickness="0"
                Padding="12,8"
                HorizontalOptions="Center"
                IsVisible="{Binding IsEditMode}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <HorizontalStackLayout Spacing="8">

                    <Label
                        Text="📝"
                        FontSize="16"
                        TextColor="{StaticResource PrimaryDark}" />

                    <Label
                        Text="Editando solicitud"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="{StaticResource PrimaryDark}" />

                </HorizontalStackLayout>

            </Border>

            <Label
                Text="Completa la información para coordinar una evaluación personalizada de tu jardín."
                HorizontalTextAlignment="Center"
                Padding="15,0"
                Style="{StaticResource SubtitleLabel}" />

            <Border
                Style="{StaticResource FormBorder}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="16">

                    <Label Text="Nombre completo"
                           Style="{StaticResource FieldLabel}" />

                    <Border BackgroundColor="{StaticResource Background}"
                            Stroke="#E5E7EB"
                            Padding="14,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Entry Text="{Binding FullName, Mode=TwoWay}"
                               Placeholder="Ej. María Pérez"
                               Style="{StaticResource InputEntry}" />
                    </Border>

                    <Label
                        Text="{Binding FullNameError}"
                        TextColor="{StaticResource Alert}"
                        FontSize="12"
                        Margin="6,-10,0,0" />

                    <Label Text="Teléfono"
                           Style="{StaticResource FieldLabel}" />

                    <Border BackgroundColor="{StaticResource Background}"
                            Stroke="#E5E7EB"
                            Padding="14,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Entry Text="{Binding Phone, Mode=TwoWay}"
                               Placeholder="Ej. 809-000-0000"
                               Keyboard="Telephone"
                               Style="{StaticResource InputEntry}" />
                    </Border>

                    <Label
                        Text="{Binding PhoneError}"
                        TextColor="{StaticResource Alert}"
                        FontSize="12"
                        Margin="6,-10,0,0" />

                    <Label Text="Tipo de servicio"
                           Style="{StaticResource FieldLabel}" />

                    <Border BackgroundColor="{StaticResource Background}"
                            Stroke="#E5E7EB"
                            Padding="14,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Picker ItemsSource="{Binding ServiceTypes}"
                                SelectedItem="{Binding SelectedServiceType, Mode=TwoWay}"
                                Title="Selecciona un servicio"
                                Style="{StaticResource InputPicker}">
                        </Picker>
                    </Border>

                    <Label
                        Text="{Binding ServiceTypeError}"
                        TextColor="{StaticResource Alert}"
                        FontSize="12"
                        Margin="6,-10,0,0" />

                    <Label Text="Fecha deseada"
                           Style="{StaticResource FieldLabel}" />

                    <Border
                        BackgroundColor="{StaticResource Background}"
                        Stroke="#E5E7EB"
                        Padding="14,4">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="10">

                            <Label
                                Text="📅"
                                FontSize="18"
                                VerticalOptions="Center" />

                            <Label
                                x:Name="SelectedDateFieldLabel"
                                Grid.Column="1"
                                Text="Selecciona una fecha"
                                TextColor="{StaticResource Black}"
                                FontSize="14"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="2"
                                Text="⌄"
                                TextColor="{StaticResource PrimaryDark}"
                                FontSize="20"
                                VerticalOptions="Center" />

                            <DatePicker
                                x:Name="DesiredDatePicker"
                                Grid.ColumnSpan="3"
                                Opacity="0.01"
                                Date="{Binding SelectedDate, Mode=TwoWay}"
                                DateSelected="DesiredDatePicker_DateSelected"
                                PropertyChanged="DesiredDatePicker_PropertyChanged" />

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDateFieldTapped" />
                            </Grid.GestureRecognizers>

                        </Grid>
                    </Border>

                    <Label
                        Text="{Binding DateError}"
                        TextColor="{StaticResource Alert}"
                        FontSize="12"
                        Margin="6,-10,0,0" />

                    <Label
                        x:Name="SelectedDateLabel"
                        Text="{Binding SelectedDateDisplay}"
                        Style="{StaticResource SubtitleLabel}"
                        Margin="4,0,0,10"
                        TextColor="{StaticResource PrimaryDark}" />

                    <Label Text="Comentarios"
                           Style="{StaticResource FieldLabel}" />

                    <Border BackgroundColor="{StaticResource Background}"
                            Stroke="#E5E7EB"
                            Padding="14,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Editor Text="{Binding Comments, Mode=TwoWay}"
                                Placeholder="Describe brevemente el servicio que necesita..."
                                AutoSize="TextChanges"
                                HeightRequest="110"
                                Style="{StaticResource InputEditor}" />
                    </Border>

                    <Label
                        Text="{Binding CommentsError}"
                        TextColor="{StaticResource Alert}"
                        FontSize="12"
                        Margin="6,-10,0,0" />

                    <Button
                        Text="{Binding SubmitButtonText}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,10,0,0"
                        Command="{Binding SaveRequestCommand}" />

                    <Button
                        Text="Eliminar solicitud"
                        BackgroundColor="{StaticResource Alert}"
                        TextColor="{StaticResource White}"
                        FontAttributes="Bold"
                        CornerRadius="18"
                        HeightRequest="54"
                        Margin="0,8,0,0"
                        IsVisible="{Binding IsEditMode}"
                        Command="{Binding DeleteRequestCommand}" />

                    <Border
                        BackgroundColor="#EAF7E3"
                        StrokeThickness="0"
                        Padding="14,12"
                        Margin="0,10,0,0"
                        IsVisible="{Binding HasSuccessMessage}">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>

                        <HorizontalStackLayout Spacing="10">

                            <Label
                                FontSize="18"
                                TextColor="{StaticResource PrimaryDark}"
                                VerticalOptions="Center"/>

                            <Label
                                Text="{Binding SuccessMessage}"
                                TextColor="{StaticResource PrimaryDark}"
                                FontSize="13"
                                FontAttributes="Bold"
                                VerticalOptions="Center"/>

                        </HorizontalStackLayout>

                    </Border>

                </VerticalStackLayout>
                <Border.Shadow>
                    <Shadow
                        Brush="Black"
                        Offset="0,2"
                        Radius="10"
                        Opacity="0.1" />
                </Border.Shadow>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>