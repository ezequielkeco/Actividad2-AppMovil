<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Marila_Garden_App.Views.Request.RequestPage"
             BackgroundColor="#F7F8F5"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <Label
                Text="Solicitar servicio"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#24541B"
                Margin="0,20,0,0" />

            <Label
                Text="Completa la información para coordinar una evaluación personalizada de tu jardín."
                FontSize="15"
                TextColor="#666666" />

            <Border
                BackgroundColor="White"
                Stroke="#E5E7EB"
                StrokeThickness="1"
                Padding="22">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="16">

                    <Label Text="Nombre completo"
                           FontAttributes="Bold"
                           TextColor="#24541B" />

                    <Border BackgroundColor="#F7F8F5"
                            Stroke="#E5E7EB"
                            Padding="14,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Entry Placeholder="Ej. María Pérez"
                               TextColor="#1F1F1F"
                               PlaceholderColor="#999999"
                               BackgroundColor="Transparent" />
                    </Border>

                    <Label Text="Teléfono"
                           FontAttributes="Bold"
                           TextColor="#24541B" />

                    <Border BackgroundColor="#F7F8F5"
                            Stroke="#E5E7EB"
                            Padding="14,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Entry Placeholder="Ej. 809-000-0000"
                               Keyboard="Telephone"
                               TextColor="#1F1F1F"
                               PlaceholderColor="#999999"
                               BackgroundColor="Transparent" />
                    </Border>

                    <Label Text="Tipo de servicio"
                           FontAttributes="Bold"
                           TextColor="#24541B" />

                    <Border BackgroundColor="#F7F8F5"
                            Stroke="#E5E7EB"
                            Padding="14,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Picker Title="Selecciona un servicio"
                                TitleColor="#999999"
                                TextColor="#1F1F1F"
                                BackgroundColor="Transparent">
                            <Picker.Items>
                                <x:String>Diseño de jardines</x:String>
                                <x:String>Mantenimiento integral</x:String>
                                <x:String>Poda profesional</x:String>
                                <x:String>Instalación de plantas</x:String>
                            </Picker.Items>
                        </Picker>
                    </Border>

                    <Label Text="Fecha deseada"
                           FontAttributes="Bold"
                           TextColor="#24541B" />

                    <Border BackgroundColor="#F7F8F5"
                            Stroke="#E5E7EB"
                            Padding="14,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <DatePicker TextColor="#1F1F1F"
                                    BackgroundColor="Transparent" />
                    </Border>

                    <Label Text="Comentarios"
                           FontAttributes="Bold"
                           TextColor="#24541B" />

                    <Border BackgroundColor="#F7F8F5"
                            Stroke="#E5E7EB"
                            Padding="14,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Editor Placeholder="Describe brevemente el servicio que necesita..."
                                AutoSize="TextChanges"
                                HeightRequest="110"
                                TextColor="#1F1F1F"
                                PlaceholderColor="#999999"
                                BackgroundColor="Transparent" />
                    </Border>

                    <Button
                        Text="Enviar solicitud"
                        BackgroundColor="#64BC1E"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="18"
                        HeightRequest="54"
                        Margin="0,10,0,0" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>