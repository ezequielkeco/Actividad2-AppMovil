<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Marila_Garden_App.Views.Request.RequestPage"
             BackgroundColor="{StaticResource Background}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="20">

            <Image Source="marila_garden_logo.png"
                   WidthRequest="150"
                   HorizontalOptions="Center"
                   Aspect="AspectFit" />

            <Label
                Text="Solicitar servicio"
                HorizontalTextAlignment="Center"
                Style="{StaticResource TitleLabel}"
                Margin="0,20,0,0" />

            <Label
                Text="Completa la información para coordinar una evaluación personalizada de tu jardín."
                HorizontalTextAlignment="Center"
                Padding="15,0"
                Style="{StaticResource SubtitleLabel}" />

            <Border
                Style="{StaticResource FormBorder}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="16">

                    <Label Text="Nombre completo"
                           Style="{StaticResource FieldLabel}" />

                    <Border BackgroundColor="{StaticResource Background}"
                            Stroke="#E5E7EB"
                            Padding="14,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Entry Placeholder="Ej. María Pérez"
                               Style="{StaticResource InputEntry}" />
                    </Border>

                    <Label Text="Teléfono"
                           Style="{StaticResource FieldLabel}" />

                    <Border BackgroundColor="{StaticResource Background}"
                            Stroke="#E5E7EB"
                            Padding="14,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Entry Placeholder="Ej. 809-000-0000"
                               Keyboard="Telephone"
                               Style="{StaticResource InputEntry}" />
                    </Border>

                    <Label Text="Tipo de servicio"
                           Style="{StaticResource FieldLabel}" />

                    <Border BackgroundColor="{StaticResource Background}"
                            Stroke="#E5E7EB"
                            Padding="14,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Picker Title="Selecciona un servicio"
                                Style="{StaticResource InputPicker}">
                            <Picker.Items>
                                <x:String>Diseño de jardines</x:String>
                                <x:String>Mantenimiento integral</x:String>
                                <x:String>Poda profesional</x:String>
                                <x:String>Instalación de plantas</x:String>
                            </Picker.Items>
                        </Picker>
                    </Border>

                    <Label Text="Fecha deseada"
                           Style="{StaticResource FieldLabel}" />

                    <Border BackgroundColor="{StaticResource Background}"
                            Stroke="#E5E7EB"
                            Padding="14,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <DatePicker Style="{StaticResource InputDatePicker}" />
                    </Border>

                    <Label Text="Comentarios"
                           Style="{StaticResource FieldLabel}" />

                    <Border BackgroundColor="{StaticResource Background}"
                            Stroke="#E5E7EB"
                            Padding="14,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Editor Placeholder="Describe brevemente el servicio que necesita..."
                                AutoSize="TextChanges"
                                HeightRequest="110"
                                Style="{StaticResource InputEditor}" />
                    </Border>

                    <Button
                        Text="Enviar solicitud"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,10,0,0" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>