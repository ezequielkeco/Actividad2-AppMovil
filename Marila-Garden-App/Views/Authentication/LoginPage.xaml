<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Marila_Garden_App.Views.Authentication.LoginPage"
             BackgroundColor="#F7F8F5"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid Padding="28" RowDefinitions="Auto,*">

            <VerticalStackLayout
                Grid.Row="0"
                Spacing="18"
                Margin="0,35,0,20">

                <Image
                    Source="marila_garden_logo.png"
                    WidthRequest="210"
                    HorizontalOptions="Center"
                    Aspect="AspectFit" />

                <Label
                    Text="Bienvenido"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="#24541B"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Accede a tu cuenta para solicitar y consultar servicios de jardinería."
                    FontSize="15"
                    TextColor="#666666"
                    HorizontalTextAlignment="Center"
                    LineHeight="1.2" />

            </VerticalStackLayout>

            <Border
                Grid.Row="1"
                BackgroundColor="White"
                Stroke="#E5E7EB"
                StrokeThickness="1"
                Padding="24"
                Margin="0,20,0,0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="18">

                    <Label
                        Text="Correo electrónico"
                        FontSize="14"
                        TextColor="#24541B"
                        FontAttributes="Bold" />

                    <Border
                        BackgroundColor="#F7F8F5"
                        Stroke="#E5E7EB"
                        StrokeThickness="1"
                        Padding="14,4">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Entry
                            Placeholder="ejemplo@correo.com"
                            Keyboard="Email"
                            TextColor="#1F1F1F"
                            PlaceholderColor="#999999"
                            BackgroundColor="Transparent" />
                    </Border>

                    <Label
                        Text="Contraseña"
                        FontSize="14"
                        TextColor="#24541B"
                        FontAttributes="Bold" />

                    <Border
                        BackgroundColor="#F7F8F5"
                        Stroke="#E5E7EB"
                        StrokeThickness="1"
                        Padding="14,4">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Entry
                            Placeholder="Ingresa tu contraseña"
                            IsPassword="True"
                            TextColor="#1F1F1F"
                            PlaceholderColor="#999999"
                            BackgroundColor="Transparent" />
                    </Border>

                    <Button
                        Text="Iniciar sesión"
                        BackgroundColor="#64BC1E"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="18"
                        HeightRequest="54"
                        Margin="0,12,0,0" />

                    <Label
                        Text="¿Aún no tienes cuenta? Crear cuenta"
                        FontSize="14"
                        TextColor="#666666"
                        HorizontalTextAlignment="Center"
                        Margin="0,8,0,0" />

                </VerticalStackLayout>

            </Border>

        </Grid>
    </ScrollView>

</ContentPage>