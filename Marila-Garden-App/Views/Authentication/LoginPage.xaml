<?xml version="1.0" encoding="utf-8" ?>
    
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Marila_Garden_App.Views.Authentication.LoginPage"
             BackgroundColor="{StaticResource Background}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid Padding="26" RowDefinitions="Auto,*">

            <VerticalStackLayout
                Grid.Row="0"
                Spacing="5"
                Margin="0,15,0,20">

                <Image
                    Source="marila_garden_logo.png"
                    WidthRequest="180"
                    HorizontalOptions="Center"
                    Aspect="AspectFit" />

                <Label
                    Text="¡Hola!"
                    Style="{StaticResource SectionTitleLabel}"
                    Padding="0,20,0,0"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Accede a tu cuenta para solicitar y consultar servicios de jardinería."
                    Style="{StaticResource SubtitleLabel}"
                    HorizontalTextAlignment="Center"
                    Padding="20,0,20,0"
                    LineHeight="1.1" />

            </VerticalStackLayout>

            <Border
                Grid.Row="1"
                Style="{StaticResource FormBorder}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="Usuario o correo electrónico"
                        Style="{StaticResource FieldLabel}" />

                    <Border
                        Stroke="#E5E7EB"
                        StrokeThickness="1"
                        Padding="14,4">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Entry
                            x:Name="UserNameEntry"
                            Text="{Binding UserName, Mode=TwoWay}"
                            Placeholder="Usuario o correo electrónico"
                            ReturnType="Next"
                            Style="{StaticResource InputEntry}" />
                    </Border>

                    <Label
                        Text="{Binding UserNameError}"
                        TextColor="{StaticResource Alert}"
                        FontSize="14"
                        HorizontalTextAlignment="Center"
                        Margin="6,-10,0,0" />

                    <Label
                        Text="Contraseña"
                        Style="{StaticResource FieldLabel}" />

                    <Border
                        BackgroundColor="#F7F8F5"
                        Stroke="#E5E7EB"
                        StrokeThickness="1"
                        Padding="14,4">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <Entry
                            x:Name="PasswordEntry"
                            Placeholder="Ingresa tu contraseña"
                            IsPassword="True"
                            Text="{Binding Password, Mode=TwoWay}"
                            Style="{StaticResource InputEntry}" />
                    </Border>

                    <Label
                         Text="{Binding PasswordError}"
                         TextColor="{StaticResource Alert}"
                         FontSize="14"
                         Margin="6,-10,0,0"
                         HorizontalTextAlignment="Center"
                         LineBreakMode="WordWrap" />

                    <Button
                        Text="Iniciar sesión"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,5,0,0"
                        Command="{Binding LoginCommand}" />

                    <Label
                        Text="¿No tienes una cuenta?"
                        HorizontalTextAlignment="Center"
                        Margin="0,10,0,0"
                        Style="{StaticResource SubtitleLabel}" />

                    <Button
                        Text="Crea una gratis"
                        BackgroundColor="Transparent"
                        FontAttributes="Bold"
                        FontSize="16"
                        TextColor="{StaticResource PrimaryDark}"
                        Command="{Binding GoToRegisterCommand}" />

                </VerticalStackLayout>

                <Border.Shadow>
                    <Shadow
                        Brush="Black"
                        Offset="0,5"
                        Radius="10"
                        Opacity="0.1" />
                </Border.Shadow>

            </Border>

        </Grid>
    </ScrollView>

</ContentPage>