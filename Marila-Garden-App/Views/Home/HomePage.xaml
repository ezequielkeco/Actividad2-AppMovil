<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Marila_Garden_App.Views.Home.HomePage"
             BackgroundColor="{StaticResource Background}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="24">

            <Grid ColumnDefinitions="*,Auto"
                  Margin="0,20,0,0">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Hola, bienvenido"
                           Style="{StaticResource SubtitleLabel}" />

                    <Label Text="Marila Garden"
                           Style="{StaticResource TitleLabel}" />
                </VerticalStackLayout>

                <Image Source="marila_garden_logo.png"
                       WidthRequest="130"
                       HorizontalOptions="End"
                       Aspect="AspectFit" />
            </Grid>

            <Border BackgroundColor="{StaticResource PrimaryDark}"
                    Padding="24"
                    StrokeThickness="0">
                <Border.Shadow>
                    <Shadow
                        Brush="Black"
                        Offset="0,5"
                        Radius="10"
                        Opacity="0.4" />
                </Border.Shadow>

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Label Text="Diseños de jardines que elevan tu bienestar"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}"
                           HorizontalTextAlignment="Center"
                           LineHeight="1.1" />

                    <Label Text="Solicita asesoría personalizada para transformar tus espacios verdes."
                           FontSize="17"
                           TextColor="{StaticResource SecondaryDarkText}"
                           HorizontalTextAlignment="Center"
                           LineHeight="1.2" />

                    <Button Text="Solicitar servicio"
                            Style="{StaticResource PrimaryButton}"
                            HeightRequest="48"
                            Margin="0,10,0,0" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Servicios destacados"
                   HorizontalTextAlignment="Center"
                   Style="{StaticResource SectionTitleLabel}" />

            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="10"
                  RowSpacing="10">

                <Border Style="{StaticResource CardBorder}"
                        Padding="10,15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🌱" FontSize="35"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Diseño de jardines"
                               HorizontalTextAlignment="Center"
                               Style="{StaticResource FieldLabel}" />
                        <Label Text="Espacios naturales personalizados."
                               FontSize="15"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource PrimaryText}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource CardBorder}"
                        Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="✂️" FontSize="35"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Mantenimiento"
                               HorizontalTextAlignment="Center"
                               Style="{StaticResource FieldLabel}" />
                        <Label Text="Cuidado responsable y continuo."
                               HorizontalTextAlignment="Center"
                               FontSize="15" TextColor="{StaticResource PrimaryText}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1"
                        Style="{StaticResource CardBorder}"
                        Padding="20,15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🪴" FontSize="35"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Instalación"
                               HorizontalTextAlignment="Center"
                               Style="{StaticResource FieldLabel}" />
                        <Label Text="Plantas, maceteros y detalles."
                               HorizontalTextAlignment="Center"
                               FontSize="15" TextColor="{StaticResource PrimaryText}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource CardBorder}"
                        Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🌳"
                               HorizontalTextAlignment="Center"
                               FontSize="35" />
                        <Label Text="Poda"
                               HorizontalTextAlignment="Center"
                               Style="{StaticResource FieldLabel}" />
                        <Label Text="Control, salud y estética vegetal."
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource PrimaryText}" />
                    </VerticalStackLayout>
                </Border>

            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>