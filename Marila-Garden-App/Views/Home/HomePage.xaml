<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Marila_Garden_App.Views.Home.HomePage"
             BackgroundColor="#F7F8F5"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24">

            <Grid ColumnDefinitions="*,Auto" Margin="0,20,0,0">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Hola, bienvenido"
                           FontSize="15"
                           TextColor="#666666" />

                    <Label Text="Marila Garden"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#24541B" />
                </VerticalStackLayout>

                <Border Grid.Column="1"
                        WidthRequest="48"
                        HeightRequest="48"
                        BackgroundColor="#FFFFFF"
                        Stroke="#E5E7EB"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>

                    <Label Text="🌿"
                           FontSize="24"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </Grid>

            <Border BackgroundColor="#24541B"
                    Padding="24"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Label Text="Diseñamos jardines que elevan tu bienestar"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"
                           LineHeight="1.1" />

                    <Label Text="Solicita asesoría personalizada para transformar tus espacios verdes."
                           FontSize="15"
                           TextColor="#DDEFD5"
                           LineHeight="1.2" />

                    <Button Text="Solicitar servicio"
                            BackgroundColor="#64BC1E"
                            TextColor="White"
                            CornerRadius="18"
                            HeightRequest="48"
                            FontAttributes="Bold"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Servicios destacados"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#24541B" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14">

                <Border BackgroundColor="White" Padding="18" Stroke="#E5E7EB">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🌱" FontSize="30" />
                        <Label Text="Diseño de jardines" FontAttributes="Bold" TextColor="#24541B" />
                        <Label Text="Espacios naturales personalizados." FontSize="13" TextColor="#666666" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" BackgroundColor="White" Padding="18" Stroke="#E5E7EB">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="✂️" FontSize="30" />
                        <Label Text="Mantenimiento" FontAttributes="Bold" TextColor="#24541B" />
                        <Label Text="Cuidado responsable y continuo." FontSize="13" TextColor="#666666" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" BackgroundColor="White" Padding="18" Stroke="#E5E7EB">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🪴" FontSize="30" />
                        <Label Text="Instalación" FontAttributes="Bold" TextColor="#24541B" />
                        <Label Text="Plantas, maceteros y detalles." FontSize="13" TextColor="#666666" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="White" Padding="18" Stroke="#E5E7EB">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="🌳" FontSize="30" />
                        <Label Text="Poda" FontAttributes="Bold" TextColor="#24541B" />
                        <Label Text="Control, salud y estética vegetal." FontSize="13" TextColor="#666666" />
                    </VerticalStackLayout>
                </Border>

            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>