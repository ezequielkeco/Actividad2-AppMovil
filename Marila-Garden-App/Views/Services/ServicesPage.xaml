<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Marila_Garden_App.Views.Services.ServicesPage"
             BackgroundColor="{StaticResource Background}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
                Padding="20"
                Spacing="20">

            <Grid ColumnDefinitions="Auto,*,Auto"
                  Margin="0,10,0,0"
                  ColumnSpacing="14">

                <ImageButton
                    Source="menu.png"
                    Clicked="OnMenuClicked" />

                <VerticalStackLayout
                    Grid.Column="1">

                    <Label
                        Margin="0,8,0,0"
                        Text="¡Hola!"
                        Style="{StaticResource SubtitleLabel}" />

                    <Label x:Name="UserNameLabel"
                           FontSize="18"
                           Text="Usuario"
                           Style="{StaticResource SectionTitleLabel}" />
                    
                </VerticalStackLayout>
                
                <Image Source="marila_garden_logo.png"
                       WidthRequest="110"
                       HorizontalOptions="End"
                       Aspect="AspectFit" 
                       Grid.Column="2"/>
            </Grid>

            <Label
                Text="Nuestros Servicios"
                HorizontalTextAlignment="Center"
                Style="{StaticResource SectionTitleLabel}"
                Margin="0,20,0,0" />

            <Label
                Text="Soluciones personalizadas para crear y mantener espacios verdes únicos."
                HorizontalTextAlignment="Center"
                Padding="20,0"
                Style="{StaticResource SubtitleLabel}" />

            <!-- Servicio - Diseño de Jardines -->

            <Border
                BackgroundColor="White"
                Stroke="#E5E7EB"
                Margin="0,10,0,-10"
                Padding="20">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24"/>
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="10">

                <Label
                        Text="🌱"
                        HorizontalTextAlignment="Center"
                        FontSize="38"/>

                <Label
                        Text="Diseño de Jardín"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource SectionTitleLabel}"/>

                <Label
                        Text="Diseñamos jardines personalizados que armonizan con el espacio y las necesidades del cliente."
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource SubtitleLabel}"/>

            </VerticalStackLayout>
            <Border.Shadow>
                <Shadow
                        Brush="Black"
                        Offset="0,2"
                        Radius="10"
                        Opacity="0.1" />
                </Border.Shadow>

            </Border>

            <!-- Servicio - Poda Profesional -->

            <Border
                BackgroundColor="White"
                Stroke="#E5E7EB"
                Margin="0,0,0,-10"
                Padding="20">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24"/>
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="10">

                <Label
                        Text="✂️"
                        HorizontalTextAlignment="Center"
                        FontSize="38"/>

                <Label
                        Text="Mantenimiento"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource SectionTitleLabel}"/>

                <Label
                        Text="Mantenimiento y control del crecimiento para conservar la salud y estética de las plantas."
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource SubtitleLabel}"/>

            </VerticalStackLayout>
            <Border.Shadow>
                <Shadow
                        Brush="Black"
                        Offset="0,2"
                        Radius="10"
                        Opacity="0.1" />
                </Border.Shadow>

            </Border>

            <!-- Servicio - Instalación de Plantas -->

            <Border
                BackgroundColor="White"
                Stroke="#E5E7EB"
                Margin="0,0,0,-10"
                Padding="20">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24"/>
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="10">

                <Label
                        Text="🪴"
                        HorizontalTextAlignment="Center"
                        FontSize="38"/>

                <Label
                        Text="Plantación"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource SectionTitleLabel}"/>

                <Label
                        Text="Selección e instalación de especies adecuadas para interiores y exteriores."
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource SubtitleLabel}"/>

            </VerticalStackLayout>
            <Border.Shadow>
                <Shadow
                        Brush="Black"
                        Offset="0,2"
                        Radius="10"
                        Opacity="0.1" />
            </Border.Shadow>

        </Border>

            <!-- Servicio - Mantenimiento Integral -->

            <Border
                BackgroundColor="White"
                Stroke="#E5E7EB"
                Margin="0,0,0,-10"
                Padding="20">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24"/>
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="10">

                <Label
                        Text="🌳"
                        HorizontalTextAlignment="Center"
                        FontSize="38"/>

                <Label
                        Text="Poda profesional"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource SectionTitleLabel}"/>

                <Label
                        Text="Programas de mantenimiento periódico para jardines residenciales y comerciales."
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource SubtitleLabel}"/>

            </VerticalStackLayout>
            <Border.Shadow>
                <Shadow
                        Brush="Black"
                        Offset="0,2"
                        Radius="10"
                        Opacity="0.1" />
            </Border.Shadow>

        </Border>

      </VerticalStackLayout>

    </ScrollView>

</ContentPage>