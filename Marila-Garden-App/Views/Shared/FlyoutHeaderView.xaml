<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="Marila_Garden_App.Views.Shared.FlyoutHeaderView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F7F8F5"
    HorizontalOptions="Fill"
    VerticalOptions="Fill">

    <Grid
        Padding="24,40,24,24"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="40"
        HorizontalOptions="Fill"
        VerticalOptions="Fill">

        <Image
            Source="marila_garden_logo.png"
            WidthRequest="150"
            HorizontalOptions="Center"
            Aspect="AspectFit" />

        <VerticalStackLayout
            Grid.Row="1"
            Spacing="4"
            HorizontalOptions="Center">

            <Label
                Text="¡Hola!"
                FontSize="16"
                TextColor="#666666"
                HorizontalTextAlignment="Center" />

            <Label
                Text="{Binding UserName}"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="#24541B"
                HorizontalTextAlignment="Center"
                LineBreakMode="TailTruncation"
                MaxLines="2" />

        </VerticalStackLayout>

        <BoxView
            Grid.Row="2"
            HeightRequest="2"
            Color="#64BC1E"
            WidthRequest="170"
            VerticalOptions="Start" />

        <Button
            Grid.Row="3"
            Text="Cerrar sesión"
            Command="{Binding LogoutCommand}"
            BackgroundColor="#C2EA78"
            TextColor="#005300"
            FontAttributes="Bold"
            FontSize="16"
            HeightRequest="50"
            WidthRequest="160"
            CornerRadius="16" />

    </Grid>

</ContentView>