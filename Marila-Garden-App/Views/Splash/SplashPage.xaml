<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Marila_Garden_App.Views.Splash.SplashPage"
             BackgroundColor="#F7F8F5"
             Shell.NavBarIsVisible="False">

    <Grid Padding="32">

        <VerticalStackLayout
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Spacing="22">

            <Image
                Source="marila_garden_logo.png"
                WidthRequest="260"
                Aspect="AspectFit" />

            <Label
                Text="Transformando espacios verdes"
                FontSize="16"
                TextColor="#666666"
                HorizontalTextAlignment="Center" />

            <ActivityIndicator
                IsRunning="True"
                Color="#64BC1E"
                WidthRequest="36"
                HeightRequest="36" />

        </VerticalStackLayout>

    </Grid>


</ContentPage>